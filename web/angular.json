{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "projects": {
    "MangaOfflineViewerAngular": {
      "root": "",
      "projectType": "application",
      "sourceRoot": "src",
      "architect": {
        "build": {
          "builder": "@angular-devkit/build-angular:browser",
          "options": {
            "sourceMap": {
              "scripts": true,
              "styles": true,
              "vendor": true
            },
            "outputPath": "dist/MangaOfflineViewerAngular/MangaOfflineViewer",
            "index": "src/index.html",
            "main": "src/main.ts",
            "polyfills": "src/polyfills.ts",
            "tsConfig": "tsconfig.app.json",
            "assets": [
              "src/assets"
            ],
            "styles": [
              "src/styles.css",
              "src/app/shared/styles/buttons.css",
              "src/app/shared/styles/textbox.css",
              "src/app/shared/styles/window-container.css"
            ],
            "scripts": [],
            "serviceWorker": false,
            "webWorkerTsConfig": "tsconfig.worker.json"
          },
          "configurations": {
            "production-local": {
              "serviceWorker": true,
              "ngswConfigPath": "ngsw-config.local.json",
              "optimization": true,
              "outputHashing": "all",
              "baseHref": "/",
              "deployUrl": "/",
              "fileReplacements": [
                {
                  "replace": "src/assets/manifest.json",
                  "with": "src/assets/manifest.local.json"
                }
              ]
            },
            "production-gh": {
              "serviceWorker": true,
              "ngswConfigPath": "ngsw-config.gh.json",
              "optimization": true,
              "outputHashing": "all",
              "baseHref": "/MangaOfflineViewer/",
              "deployUrl": "/MangaOfflineViewer/",
              "fileReplacements": [
                {
                  "replace": "src/assets/manifest.json",
                  "with": "src/assets/manifest.gh.json"
                }
              ]
            }
          }
        },
        "serve": {
          "builder": "@angular-devkit/build-angular:dev-server",
          "options": {
            "buildTarget": "MangaOfflineViewerAngular:build"
          }
        },
        "deploy": {
          "builder": "angular-cli-ghpages:deploy",
          "options": {
            "dir": "dist/MangaOfflineViewerAngular/MangaOfflineViewer",
            "buildConfiguration": "production-gh",
            "baseHref": "/MangaOfflineViewer/"
          }
        }
      }
    }
  },
  "defaultProject": "MangaOfflineViewerAngular",
  "cli": {
    "analytics": false
  }
}
